@model Cafe_POS.Models.CafeOrder

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Order Details";
}
<div><a class="back-btn" asp-controller="Home" asp-action="Index">Back</a></div>

<h2>@ViewBag.Title</h2>

<div>
    <h4>Order #@Model.OrderId</h4>
    <hr/>
    <h4>@Model.Server.FirstName</h4>
    <h4>@Model.OrderDate</h4>
</div>
<hr />
<h4>Items</h4>
<div class="item-list-container">
    
    <ul class="item-list">
         @foreach (var item in Model.OrderItems){
            <li>@item.Quantity - @item.ItemPrice.Item.ItemName</li>
        }
    </ul>
</div>
<div class="amount-due-list-container">
    <dl class="amount-due-list">
        <dt>Subtotal</dt>
        <dd>@Model.SubTotal</dd>

        <dt>Tax</dt>
        <dd>@Model.Tax</dd>

        <dt>Amount Due</dt>
        <dd>@Model.AmountDue</dd>
    </dl>
</div>
<hr />
<div class="details-btns">
    <a class="add-items-btn" asp-controller="Item" asp-action="AddItems" asp-route-orderId="@Model.OrderId">Add Items To Order</a>

    <a class="process-payment-btn" asp-controller="Order" asp-action="ProcessPayment">Process Payment</a>
</div>
   
    

