@using Cafe_POS.Models
@model IEnumerable<Cafe_POS.Models.Server>

@{
    ViewData["Title"] = "Create New Order";
}

<h1>@ViewData["Title"]</h1>

<h2>Active Servers</h2>

    <ul>
        @foreach (var server in Model)
        {
            <li>
                Server @server.FirstName
                <a asp-controller="Order" asp-action="CreateNew" asp-route-serverId="@server.ServerId">select</a>
            </li>
        }
    </ul>