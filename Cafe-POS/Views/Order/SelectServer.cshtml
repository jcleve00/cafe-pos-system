@using Cafe_POS.Models
@model IEnumerable<Cafe_POS.Models.Server>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Select Server";
}
<div><a class="back-btn" asp-controller="Home" asp-action="Index">Back</a></div>

<h2>@ViewBag.Title</h2>
<hr />
<h3>Active Servers</h3>
<div class="active-servers-container">
    <ul class="active-servers">
        @foreach (var server in Model)
        {
            <li>
                Server @server.FirstName
                <a class="select-btn" asp-controller="Order" asp-action="CreateNew" asp-route-serverId="@server.ServerId">select</a>
            </li>
        }
    </ul>
</div>